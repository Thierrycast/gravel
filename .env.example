DATABASE_URL="file:./dev.db"

# Pluggy (Open Finance) — obrigatórias.
# De onde vêm: crie uma Application em https://dashboard.pluggy.ai
# Guia completo (contas, MeuPluggy, autorização): docs/meu-pluggy-setup.md
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""
# Opcionais (os defaults abaixo já são os corretos)
PLUGGY_API_BASE="https://api.pluggy.ai"
PLUGGY_API_KEY_HEADER="X-API-KEY"
PLUGGY_AUTH_PATH="/auth"
PLUGGY_CONNECT_TOKEN_PATH="/connect_token"
PLUGGY_API_KEY_TTL_SECONDS="7200"

# Binance (cripto) — opcional; crie uma API key read-only em https://www.binance.com
BINANCE_API_KEY=""
BINANCE_API_SECRET=""
BINANCE_API_BASE="https://api.binance.com"
BINANCE_RECV_WINDOW="5000"

# Protege os endpoints internos em /api/admin/*
INTERNAL_API_KEY=""

# Permite salvar credenciais criptografadas no banco via /settings (seção
# Segurança) em vez do .env — obrigatória só se você usar esse recurso.
# Gere com: openssl rand -hex 32
APP_SECRETS_ENCRYPTION_KEY=""

# Webhook da Pluggy — é o caminho principal de atualização de dados (ver
# docs/sync.md). Sem ele, o app só vê dado novo quando o agendador passa.
#
# URL pública HTTPS que a Pluggy vai chamar (ela rejeita http e localhost).
# No lab é a sub-rota do Tailscale Funnel, reescrita pelo Traefik para
# /api/webhooks/pluggy.
PLUGGY_WEBHOOK_URL=""
# Valida o header X-Webhook-Secret em POST /api/webhooks/pluggy. Gere com
# `openssl rand -hex 32`. Se vazio, o endpoint aceita qualquer chamada —
# configure em produção. Registre/reconcilie com:
#   pnpm gravel sync webhook --register
PLUGGY_WEBHOOK_SECRET=""

# Bases das APIs auxiliares da Pluggy (os defaults já são os corretos).
PLUGGY_ENRICHMENT_API_BASE="https://enrichment-api.pluggy.ai"
PLUGGY_INSIGHTS_API_BASE="https://insights-api.pluggy.ai"

# Desliga o agendador in-process (útil só para depurar).
# GRAVEL_DISABLE_SCHEDULER="1"

# Logo.dev (logos de instituições/cripto) — opcional; sem as chaves o app
# usa os ícones locais. https://logo.dev
LOGO_DEV_PUBLISHABLE_KEY=""
LOGO_DEV_SECRET_KEY=""

# MCP server em modo HTTP/SSE (opcional — o modo stdio não precisa de nada)
# MCP_PORT="8422"
# MCP_BIND_HOST="0.0.0.0"
# MCP_ALLOWED_HOSTS="localhost,<servidor>"

# Web Push (notificações do PWA) — gere com `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
