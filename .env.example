# Modelo do arquivo de segredos do Gravel.
#
# ── Onde este arquivo vive ───────────────────────────────────────────────────
# NÃO no repositório. Os segredos moram em um arquivo único, fora do git:
#
#   mkdir -p ~/.config/gravel && chmod 700 ~/.config/gravel
#   cp .env.example ~/.config/gravel/secrets.env
#   chmod 600 ~/.config/gravel/secrets.env
#   ln -s ~/.config/gravel/secrets.env .env      # dev e produção, uma só fonte
#
# O `docker-compose.yml` aponta para ele com `env_file:`, então o compose
# versionado não contém segredo, placeholder nem interpolação — pode ficar num
# repositório público como está.
#
# Histórico: até 2026-08-08 estas credenciais estavam literais no
# `docker-compose.yml` de um repo PÚBLICO. Todas foram rotacionadas e a
# história do git foi reescrita. Ver docs/security.md.
#
# ── Para onde isto está indo ─────────────────────────────────────────────────
# O destino é que só as duas variáveis auto-geradas abaixo fiquem em arquivo, e
# que as credenciais de terceiros vivam criptografadas (AES-256-GCM) na tabela
# `AppSecret`, geridas pela tela /settings → Segurança.

# ── Tudo aqui é OPCIONAL ────────────────────────────────────────────────────
# O app gera a chave do cofre e o token interno sozinho no primeiro boot, e as
# credenciais de provedor se cadastram em /settings → Segurança. Este arquivo
# existe só como override para quem prefere deploy declarativo.
#
# Chave AES-256-GCM do cofre. Se vazia, o app gera e guarda em
# <dir do banco>/secret.key (0600). Definir aqui sobrepõe o arquivo.
APP_SECRETS_ENCRYPTION_KEY=""

DATABASE_URL="file:./dev.db"

# Pluggy (Open Finance) — obrigatórias.
# De onde vêm: crie uma Application em https://dashboard.pluggy.ai
# Guia completo (contas, MeuPluggy, autorização): docs/meu-pluggy-setup.md
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""
# Opcionais (os defaults abaixo já são os corretos)
PLUGGY_API_BASE="https://api.pluggy.ai"
PLUGGY_API_KEY_HEADER="X-API-KEY"
PLUGGY_AUTH_PATH="/auth"
PLUGGY_CONNECT_TOKEN_PATH="/connect_token"
PLUGGY_API_KEY_TTL_SECONDS="7200"

# Binance (cripto) — opcional; crie uma API key read-only em https://www.binance.com
BINANCE_API_KEY=""
BINANCE_API_SECRET=""
BINANCE_API_BASE="https://api.binance.com"
BINANCE_RECV_WINDOW="5000"

# Token das 22 rotas internas (/api/admin/*, /api/sync/cron, disparos de sync,
# registro do webhook). NÃO criptografa nada — quem criptografa é
# APP_SECRETS_ENCRYPTION_KEY, acima. Se vazio, o app gera e guarda em
# <dir do banco>/internal-token.key (0600).
INTERNAL_API_KEY=""

# Webhook da Pluggy — é o caminho principal de atualização de dados (ver
# docs/sync.md). Sem ele, o app só vê dado novo quando o agendador passa.
#
# URL pública HTTPS que a Pluggy vai chamar (ela rejeita http e localhost).
# No lab é a sub-rota do Tailscale Funnel, reescrita pelo Traefik para
# /api/webhooks/pluggy.
PLUGGY_WEBHOOK_URL=""
# Valida o header X-Webhook-Secret em POST /api/webhooks/pluggy. Gere com
# `openssl rand -hex 32`. Se vazio, o endpoint aceita qualquer chamada —
# configure em produção. Registre/reconcilie com:
#   pnpm gravel sync webhook --register
PLUGGY_WEBHOOK_SECRET=""

# Bases das APIs auxiliares da Pluggy (os defaults já são os corretos).
PLUGGY_ENRICHMENT_API_BASE="https://enrichment-api.pluggy.ai"
PLUGGY_INSIGHTS_API_BASE="https://insights-api.pluggy.ai"

# Desliga o agendador in-process (útil só para depurar).
# GRAVEL_DISABLE_SCHEDULER="1"

# Logo.dev (logos de instituições/cripto) — opcional; sem as chaves o app
# usa os ícones locais. https://logo.dev
LOGO_DEV_PUBLISHABLE_KEY=""
LOGO_DEV_SECRET_KEY=""

# MCP server em modo HTTP/SSE (opcional — o modo stdio não precisa de nada)
# MCP_PORT="8422"
# MCP_BIND_HOST="0.0.0.0"
# MCP_ALLOWED_HOSTS="localhost,<servidor>"

# Web Push (notificações do PWA) — gere com `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
