{
  "name": "gravel",
  "version": "0.1.14",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.2",
      "vite": "8.1.6",
      "zod": "4.6.7"
    }
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack && pnpm prepare:standalone",
    "prepare:standalone": "rm -rf .next/standalone/.next/static .next/standalone/public && cp -R .next/static .next/standalone/.next/static && cp -R public .next/standalone/public",
    "start": "node .next/standalone/server.js",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma": "prisma",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "gravel": "tsx --env-file=.env cli/index.ts",
    "mcp": "tsx --env-file=.env mcp/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@locator/runtime": "^0.5.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@prisma/client": "^6.19.3",
    "@serwist/next": "^9.5.13",
    "@tanstack/query-sync-storage-persister": "^5.105.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-query-persist-client": "^5.105.0",
    "chalk": "^5.6.2",
    "class-variance-authority": "^0.7.1",
    "cli-table3": "^0.6.5",
    "clsx": "^2.1.1",
    "commander": "^14.0.3",
    "d3-sankey": "^0.12.3",
    "d3-shape": "^3.2.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "next-view-transitions": "^0.3.5",
    "ora": "^9.4.1",
    "radix-ui": "^1.8.1",
    "react": "19.2.3",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.3",
    "react-pluggy-connect": "^2.12.0",
    "recharts": "2.15.4",
    "serwist": "^9.5.13",
    "shadcn": "4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^2.0.0",
    "voice-kit": "file:vendor/voice-kit",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitest/ui": "^4.1.12",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "8.1.6",
    "vitest": "^4.1.12"
  }
}
